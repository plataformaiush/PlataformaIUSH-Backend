# Copiar a .env y completar valores locales (no commitear .env).

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# JWT (obligatorio en producción)
JWT_SECRET=
# Opcional: caducidad del token en segundos (por defecto 86400)
# JWT_EXPIRES_IN=86400

# Server
PORT=3000
NODE_ENV=development
# URL base del servidor (usada en las URLs de certificados)
# Local: http://localhost:3000
# Producción: https://tu-dominio.com
BASE_URL=http://localhost:3000

# Certificados (opcional)
# CERT_IMAGE_DEFAULT=
# CERT_IMAGE_URL=

# Cloudinary — almacenamiento de archivos e imágenes
# Cuenta compartida del proyecto (plan gratuito)
